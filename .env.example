# ============================================================================
# FamilyApp 本地环境变量配置模板（Change 8 Compose 基线）
# 使用方法：
#   1. cp .env.example .env   # (Windows: 复制文件名为 .env)
#   2. 修改下方带 CHANGE_ME 的值（不要把真实密钥提交到 git）
#   3. docker compose config  # 检查变量插值是否生效
# 安全说明：.env 文件已在 .gitignore L87 排除，不会被提交。
#          如意外提交密钥，请立即对应平台 rotate（POSTGRES 密码/内部密钥/LLM Key）。
# ============================================================================

# ============================================================================
# 段1 / 4：本地构建环境变量（罕见需要修改；留空使用系统 PATH）
# Change 1-3 使用这些路径定位 Java/Node/Gradle 工具链；Docker 构建不读它们。
# ============================================================================
# JAVA_HOME=C:\Users\you\jdk-17                          # Windows JDK 路径（WSL/Linux 用 /usr/lib/jvm/...）
# NODE_HOME=C:\Program Files\nodejs                       # Node.js 根目录（需要 >= 18）
# GRADLE_USER_HOME=C:\Users\you\.gradle                   # Gradle 缓存目录（节省重复下载）

# ============================================================================
# 段2 / 4：PostgreSQL 数据库（4 项）
# POSTGRES_* 是容器内 postgres 初始化的主库/主用户/主密码。
# AGENT_READER_PASSWORD 是 PR-3 引入的只读角色「agent_reader」的密码占位；
#   首次部署时 V1__afterMigrate.sql 会 CREATE ROLE agent_reader + GRANT SELECT，
#   但 ALTER ROLE PASSWORD 只在 .env 设了 AGENT_READER_PASSWORD 后会由运维脚本手动执行
#   （或 flyway_idempotent.sh 第二次 migrate 前覆盖）。开发阶段可保持默认占位。
# ============================================================================
POSTGRES_DB=familyapp
POSTGRES_USER=familyapp_user  # ⚠ 必须15字符（含末尾r）；与compose默认值保持一致，否则PG初始化后28P01认证失败
POSTGRES_PASSWORD=placeholder-postgres-password
# PR-3 只读角色密码：首次部署时替换 placeholder-agent-reader-password 为强密码（16+ 位，数字/字母/符号）
AGENT_READER_PASSWORD=placeholder-agent-reader-password

# ============================================================================
# 段3 / 4：服务发现 & 内部密钥（6 项）
# BACKEND_PORT / FRONTEND_PORT：历史变量；本轮nginx网关已收敛端口，默认不再映射到宿主机。
#   如需要本地调试后端/前端（绕过nginx），可在docker-compose.yml对应service手动恢复ports映射。
# NGINX_PORT：Nginx 代理网关的宿主机映射端口（默认 80）；80被占用时改为 8080/8000 等高位端口。
# AGENT_SERVICE_BASE_URL / TOOL_SERVICE_BASE_URL：后端（backend）调用 AI 服务 / 天气工具
#   时的基座 URL；在 Docker Compose 下走 infra-tier 的 compose DNS 域名，
#   不需要也不应该改默认值（除非把 agent/tool 拆到另一个集群）。
# DB_AGENT_READER_URL：agent-service 直连 Postgres 的只读 JDBC URL。
#   格式是 Pydantic Postgres DSN：postgresql://agent_reader:<密码>@<host>:<port>/<db>
#   默认模板引用 AGENT_READER_PASSWORD 占位 + 容器 DNS postgres:5432 + POSTGRES_DB。
# INTERNAL_API_SECRET：后端 ↔ agent-service / wechat-service 的内部调用密钥
#   （对应请求头 X-Internal-Secret）。所有环境都必须显式生成强随机值，
#   留空时 Compose 拒绝解析；可用 openssl rand -base64 32 生成。
# ============================================================================
BACKEND_PORT=8080
FRONTEND_PORT=5173
NGINX_PORT=80
AGENT_SERVICE_BASE_URL=http://agent-service:8700
TOOL_SERVICE_BASE_URL=http://tool-service:8800
DB_AGENT_READER_URL=postgresql://agent_reader:${AGENT_READER_PASSWORD}@postgres:5432/${POSTGRES_DB}
INTERNAL_API_SECRET=

# ============================================================================
# 段4 / 4：第三方服务接入 & 功能开关（3 项变量组，1 条布尔开关）
# WEATHER_API_KEY：Change 3 和风/OpenWeather 天气 API Key；留空时 tool-service
#   调用 weather_type=unknown（C-15 routine 匹配降级到无天气提示分支），
#   healthz 仍返回 200，不阻塞启动。
# DEEPSEEK_*：Change 4 DeepSeek LLM 接入；留空时 agent-service 拆解请求直接返回
#   56001 「建议手动创建任务」降级，但 /healthz 仍返回 200，不阻塞启动。
#   - DEEPSEEK_BASE_URL：默认官方 https://api.deepseek.com ；如果用代理可改
#   - DEEPSEEK_MODEL：默认 deepseek-chat；V3 用户可以切 deepseek-reasone
# AI_DECOMPOSE_ENABLED：功能回退总开关。
#   - true（默认）：前端显示 AI 入口按钮，AgentProxyController 正常处理请求
#   - false：前端 AI 按钮 CSS 隐藏，AgentProxyController 所有端点直接返回 50310
#     错误消息「AI 拆解功能已关闭，请联系家庭管理员」（中文）
#   Change 8 新增：人员档案模块 + AI 拆解多轮会话（D-1~D-7 草稿-确认模型）
#     - D-1~D-4 写 agent_decompose_sessions 草稿表（POST /api/agent/v1/decompose/sessions）
#     - D-5 confirm 原子事务：更新 person_profiles + 创建 tasks（@Transactional）
#     - D-6 saveProfileOnly：仅更新 person_profiles
#     - D-7 cancel：放弃草稿，不生成待办
# ============================================================================
# WEATHER_API_KEY=                                              # 留空 = weather 未知降级模式
# DEEPSEEK_API_KEY=                                             # 留空 = AI 拆解降级模式
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_DECOMPOSE_ENABLED=true

# ============================================================================
# 段5 / 5：Change 11/12 微信公众号接入（wechat-service）
# WECHAT_APP_ID / WECHAT_APP_SECRET：公众号测试号/服务号后台凭证；
#   留空时 wechat-service 仅 /healthz 可用，不阻塞容器启动。
# WECHAT_TOKEN：公众号「服务器配置」里填写的 Token，用于回调验签（SHA-1）。
# WECHAT_OAUTH_BASE：公网可访问的隧道/域名基址（cpolar/ngrok/正式域名），
#   微信回调 URL 与网页授权域名都基于它；隧道域名每次变更后需在微信后台两处重配
#   （服务器配置 URL = <基址>/wechat/callback；网页授权域名 = 基址主机名）。
# 注意：WECHAT_APP_SECRET/WECHAT_TOKEN 属敏感信息，.env 不要提交入库。
# ============================================================================
# WECHAT_APP_ID=wx_your_app_id
# WECHAT_APP_SECRET=your_app_secret
# WECHAT_TOKEN=your_callback_token
# WECHAT_OAUTH_BASE=https://your-tunnel.example.com

# --- Change 12 微信模板消息推送（可选；留空即对应事件静默跳过，不影响业务）---
# WECHAT_NOTIFY_ENABLED：后端推送总开关，false 时完全不调用 wechat-service（默认 true）。
# WECHAT_TPL_*：微信测试号后台「模板消息」栏目新建 4 个模板后填入模板 ID；
#   字段标题须与 .handoffs/current.md Change 12 runbook 一致：
#   TASK_DIGEST 每日任务早报（keyword1 今日到期 / keyword2 逾期，跳转 /tasks）
#   SUMMARY    每日总结完成通知（keyword1 家庭名 / keyword2 日期，跳转 /dashboard）
#   TASK_ASSIGN 任务指派通知（keyword1 任务标题 / keyword2 截止日期，跳转 /tasks）
#   EVENT_DIGEST 日程早报（keyword1 今日 N 件安排 / keyword2 日程摘要，跳转 /）
# WECHAT_NOTIFY_ENABLED=true
# WECHAT_TPL_TASK_DIGEST_ID=
# WECHAT_TPL_SUMMARY_ID=
# WECHAT_TPL_TASK_ASSIGN_ID=
# WECHAT_TPL_EVENT_DIGEST_ID=

# 微信消息录入默认关闭，完整联调后再启用。
WECHAT_INTAKE_ENABLED=false
WECHAT_INBOUND_ENABLED=false
WECHAT_INTAKE_POLL_MS=5000
WECHAT_INTAKE_MAX_ATTEMPTS=3

# 新版持续会话入口与 worker 默认均关闭；切流时必须先停旧 intake/inbound。
WECHAT_CONVERSATION_ENABLED=false
WECHAT_CONVERSATION_WORKER_ENABLED=false
WECHAT_CONVERSATION_POLL_MS=1000
WECHAT_CONVERSATION_POLL_INITIAL_MS=15000
WECHAT_CONVERSATION_LEASE_SECONDS=120
# 空闲会话默认 24 小时后过期，可按部署需要调整。
WECHAT_CONVERSATION_TTL_HOURS=24
WECHAT_CONVERSATION_MAX_ATTEMPTS=5
WECHAT_CONVERSATION_RETRY_INITIAL_MS=1000
WECHAT_CONVERSATION_RETRY_MAX_MS=60000
WECHAT_CONVERSATION_PROGRESS_FAST_MS=2500
WECHAT_CONVERSATION_MAX_REPLY_SEGMENTS=3
WECHAT_CONVERSATION_SUMMARY_EVERY_TURNS=6
WECHAT_CONVERSATION_SUMMARY_CONTEXT_CHARS=6000
# 原文清理独立默认关闭，确认审计和实际任务不随历史清理删除。
WECHAT_CONVERSATION_RETENTION_ENABLED=false
WECHAT_CONVERSATION_RAW_RETENTION_DAYS=30
WECHAT_CONVERSATION_SUMMARY_RETENTION_DAYS=180
WECHAT_CONVERSATION_RETENTION_BATCH_SIZE=50
WECHAT_CONVERSATION_EXPERIENCE_POLL_MS=60000
SPRING_SCHEDULING_POOL_SIZE=4

# 邮箱密码找回：默认关闭，公网地址必须为 HTTPS 源站，凭据仅填本地环境。
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_PUBLIC_URL=
PASSWORD_RESET_FROM=
PASSWORD_RESET_SMTP_HOST=
PASSWORD_RESET_SMTP_PORT=587
PASSWORD_RESET_SMTP_USERNAME=
PASSWORD_RESET_SMTP_PASSWORD=
PASSWORD_RESET_STARTTLS=true

# 仅填写后端直接连接的可信网关完整 IP，逗号分隔；默认 Compose 网关固定为 172.29.0.2。
# 若改动 public-tier 网段或接入其他网关，必须同步更新并完成伪造头验收。
PASSWORD_RESET_TRUSTED_PROXIES=172.29.0.2

# ============================================================================
# 段6 / 6：task-planner 工作任务计划系统（合并自 task-planner 子项目）
# 独立 PG 库 task_db，与主库 familyapp 完全隔离；公网入口复用主应用登录态。
# LLM Key 默认复用上方 DEEPSEEK_API_KEY；如需独立 Key 显式设 TP_LLM_API_KEY。
# ============================================================================
TP_POSTGRES_DB=task_db
TP_POSTGRES_USER=tp
# 必填：为 task-planner 独立生成强随机数据库口令。
TP_POSTGRES_PASSWORD=
# TP_LLM_API_KEY=                                             # 留空 = 复用 DEEPSEEK_API_KEY
TP_LLM_BASE_URL=https://api.deepseek.com/v1
TP_LLM_MODEL=deepseek-chat
TP_LOG_LEVEL=INFO

# 微信任务整理独立预算；整轮需小于后端四十五秒读取时限
CONVERSATION_TIMEOUT_SECONDS=35
CONVERSATION_LLM_CONNECT_TIMEOUT_SECONDS=8
CONVERSATION_LLM_READ_TIMEOUT_SECONDS=25
CONVERSATION_LLM_SDK_MAX_RETRIES=0
CONVERSATION_LLM_MAX_ATTEMPTS=1
CONVERSATION_LLM_THINKING=disabled
CONVERSATION_LLM_MAX_TOKENS=4096
