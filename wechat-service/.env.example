# wechat-service 环境变量示例（复制为 .env 后填入；.env 不入库）
# 微信公众号测试号/服务号后台凭证
WECHAT_APP_ID=wx_your_app_id
WECHAT_APP_SECRET=your_app_secret
# 公众号服务器配置 Token（与微信后台填写一致，用于验签）
WECHAT_TOKEN=your_callback_token

# 公网回调基址（cpolar/ngrok 隧道域名），OAuth redirect_uri 与菜单 URL 基于它拼接
OAUTH_CALLBACK_BASE=https://your-tunnel.example.com
# H5 前端基址（与回调同域经 nginx 分流时保持一致）
H5_BASE_URL=https://your-tunnel.example.com

# backend 内部 API（docker 网络内服务名）
BACKEND_BASE_URL=http://backend:8080
INTERNAL_API_SECRET=change-me-internal-secret

# Change 12 模板消息 ID（测试号后台「模板消息」栏目新建后填入；留空则对应事件静默跳过）
# 字段布局见仓库 .handoffs/current.md Change 12 真机验证 runbook
WECHAT_TPL_TASK_DIGEST_ID=
WECHAT_TPL_SUMMARY_ID=
WECHAT_TPL_TASK_ASSIGN_ID=
WECHAT_TPL_EVENT_DIGEST_ID=
