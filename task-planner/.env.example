# ============================================================
# task-planner 环境变量样例
#
# 用法：cp .env.example .env 后按需填写；.env 已被仓库 .gitignore 忽略。
# 本文件不得包含任何真实密钥。
# ============================================================

# ---------- 数据库（仅 task-service 使用） ----------
POSTGRES_USER=tp
POSTGRES_PASSWORD=tp
POSTGRES_DB=task_db

# ---------- 宿主端口映射 ----------
TASK_SERVICE_PORT=8100
AGENT_SERVICE_PORT=8101

# ---------- LLM（agent-service 使用） ----------
# DeepSeek OpenAI 兼容接口；替换 LLM_BASE_URL 可指向本地桩服务用于测试
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---------- 服务间地址 ----------
# agent-service 访问 task-service 的 MCP 端点（容器网络内地址）
MCP_TASK_SERVICE_URL=http://task-service:8100/mcp
# agent-service 对外地址（供前端/CLI 会话入口使用）
AGENT_SERVICE_URL=http://agent-service:8101

# ---------- 时区与日志 ----------
# 每日总结固定 22:00 触发，以容器本地时区为基准
TZ=Asia/Shanghai
LOG_LEVEL=INFO
